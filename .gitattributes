# Linguist language overrides for correct GitHub statistics.
#
# Language distribution target (post-G5, zero Clojure):
#   TypeScript  ~50%  — logos-app SPA, MCP server, Plugin SDK, workers
#   Go          ~30%  — backend-go HTTP server, all 25 RPC namespaces
#   Rust        ~17%  — layout, renderer, rebase, vector, WASM, types
#   WGSL         ~2%  — WebGPU compute & render shaders
#   SQL          ~1%  — PostgreSQL migrations

# TypeScript (frontend SPA, plugins, MCP server)
*.ts   linguist-language=TypeScript
*.tsx  linguist-language=TypeScript

# Go (backend)
*.go   linguist-language=Go

# Rust (render, layout, vector, WASM, types)
*.rs   linguist-language=Rust

# WGSL (WebGPU shaders)
*.wgsl linguist-language=WGSL

# SQL (PostgreSQL migrations)
*.sql  linguist-language=SQL

# Generated files — mark as generated so Linguist excludes from stats
logos-app/src/types/generated/*.d.ts      linguist-generated=true
logos-app/src/types/rust-generated/*.ts   linguist-generated=true

# ── Historical dead code — preserved for git blame, not compiled ─────────────
# frontend/ was the ClojureScript SPA (superseded by logos-app/ in M5).
# exporter/ was the ClojureScript headless exporter (superseded by Go binfile).
# library/ was the ClojureScript UI component library (no longer built).
# common/  was the shared Clojure/ClojureScript schema library (superseded by
#          logos-types Rust crate).
# All are marked linguist-vendored so they are excluded from language statistics.
frontend/**  linguist-vendored=true
exporter/**  linguist-vendored=true
library/**   linguist-vendored=true
common/**    linguist-vendored=true
backend/**   linguist-vendored=true
