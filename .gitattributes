# Linguist language overrides for correct GitHub statistics.
#
# Language distribution target:
#   TypeScript  ~45%  — logos-app SPA, MCP server, Plugin SDK
#   Clojure     ~35%  — backend server, common/ schemas, exporter
#   Rust        ~15%  — layout, renderer, rebase, vector, WASM
#   WGSL         ~3%  — WebGPU compute & render shaders
#   SQL          ~2%  — PostgreSQL migrations
#
# Note: the `frontend/` directory contains ClojureScript (.cljs / .cljc)
# files that are compiled by shadow-cljs for the legacy Penpot-compatible
# UI.  These are correctly classified by Linguist as ClojureScript; no
# override is needed because they share the "Clojure" language category
# on GitHub (Linguist groups Clojure + ClojureScript + EDN together).

# Clojure (backend, common schemas, exporter)
*.clj  linguist-language=Clojure

# TypeScript (frontend SPA, plugins, MCP server)
*.ts   linguist-language=TypeScript
*.tsx  linguist-language=TypeScript

# Rust (render, layout, vector, WASM)
*.rs   linguist-language=Rust

# WGSL (WebGPU shaders)
*.wgsl linguist-language=WGSL

# SQL (PostgreSQL migrations)
*.sql  linguist-language=SQL

# Generated files — mark as generated so Linguist excludes from stats
logos-app/src/types/generated/*.d.ts  linguist-generated=true
