#!/usr/bin/env bash

if [ ! -f /opt/emsdk/emsdk_env.sh ]; then
    echo "WARNING: EMSDK not found at /opt/emsdk/emsdk_env.sh — skipping WASM build."
    echo "To build render-wasm, install EMSDK: https://emscripten.org/docs/getting_started/downloads.html"
    exit 0
fi

EMSDK_QUIET=1 . /opt/emsdk/emsdk_env.sh

_SCRIPT_DIR=$(dirname $0);
pushd $_SCRIPT_DIR;

. ./_build_env

set -ex;

setup;
build;
copy_artifacts "../frontend/resources/public/js";
copy_shared_artifact;

exit $?;

popd
