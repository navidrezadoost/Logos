# docker/images/Dockerfile.frontend
# Multi-stage build for the Logos React + TypeScript frontend (logos-app).
#
# Stage 1 — builder: installs deps and runs Vite production build
# Stage 2 — nginx:   serves the static bundle on port 80
#
# Build (from repo root):
#   docker build -f docker/images/Dockerfile.frontend -t logos-frontend .
#
# The WASM module is expected to be pre-built into logos-app/public/logos-layout/
# before running this build. Run `make build-wasm` first if needed.

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy manifests first for layer caching
COPY logos-app/package.json logos-app/package-lock.json ./

RUN npm ci --prefer-offline

# Copy full source
COPY logos-app/ .

RUN npm run build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

LABEL maintainer="Logos <logos@logos.app>"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Minimal nginx config: SPA fallback + asset cache headers
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # SPA: all unknown paths fall back to index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    # Immutable-hash assets get long cache\n\
    location ~* \\.(js|css|wasm|woff2?|ttf|svg|png|jpg|ico)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/logos.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
