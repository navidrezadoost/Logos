{
  "name": "Layer Counter",
  "version": "1.0.0",
  "author": "Logos Team",
  "description": "Real-time layer statistics with type breakdown and selection tools.",
  "entry_point": "plugin.js",
  "category": "DevTools",
  "license": "MIT",
  "permissions": {
    "document": ["read", "write"],
    "ui": ["panel"]
  },
  "hooks": ["onLoad", "onSelectionChange", "onLayerCreate", "onLayerDelete"],
  "commands": [
    {
      "id": "refresh-count",
      "label": "Refresh Layer Count",
      "shortcut": "Ctrl+Shift+C"
    }
  ],
  "tags": ["layers", "statistics", "counter", "devtools"]
}
