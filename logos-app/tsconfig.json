{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@logos/plugin-types": ["./src/plugins/types/generated/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/test-support/g1-b3-adapter-smoke.ts",
    "src/test-support/a10-editor-interactions-smoke.tsx",
    "src/test-support/g1-b9-3-compatibility-smoke.ts",
    "src/test-support/g1-b9-4-revision-smoke.ts",
    "src/test-support/g1-b9-5-editor-performance-smoke.tsx"
  ]
}
