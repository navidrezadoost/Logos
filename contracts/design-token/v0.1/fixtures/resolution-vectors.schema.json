{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:logos:design-token-contract:0.1.0:resolution-fixtures",
  "type": "object",
  "required": ["contractVersion", "status", "cases"],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "status": { "const": "PROPOSED" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "input", "expectedOutput"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "status": { "const": "PROPOSED" },
          "input": {
            "type": "object",
            "required": ["snapshot", "request"],
            "properties": {
              "snapshot": { "$ref": "urn:logos:design-token-contract:0.1.0#/$defs/tokenSnapshot" },
              "request": { "$ref": "urn:logos:design-token-contract:0.1.0#/$defs/resolveRequest" }
            },
            "additionalProperties": false
          },
          "expectedOutput": { "$ref": "urn:logos:design-token-contract:0.1.0#/$defs/resolveResult" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
