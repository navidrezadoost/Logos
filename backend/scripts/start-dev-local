#!/usr/bin/env bash
# Start the Penpot backend via host-clojure for local development.
# Requires: postgres on port 5433, redis on port 6380 (Docker containers).

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Source the default env
source "$SCRIPT_DIR/_env"

# Source local overrides (postgres at 5433, redis at 6380, no Minio)
if [ -f "$SCRIPT_DIR/_env.local" ]; then
    source "$SCRIPT_DIR/_env.local"
fi

# Call setup_minio (overridden to no-op in _env.local)
setup_minio

export JAVA_OPTS="\
    -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager \
    -Dlog4j2.configurationFile=log4j2-devenv.xml \
    -XX:-OmitStackTraceInFastThrow \
    --enable-preview \
    --enable-native-access=ALL-UNNAMED"

export JVM_OPTS="$JAVA_OPTS"

echo "Starting Penpot backend..."
echo "  DB:    $PENPOT_DATABASE_URI"
echo "  Redis: $PENPOT_REDIS_URI"
echo "  URI:   $PENPOT_PUBLIC_URI"
echo ""

cd "$SCRIPT_DIR/.."
exec flatpak-spawn --host env \
  JAVA_HOME=/usr/lib/jvm/java-21-openjdk \
  PATH="/usr/lib/jvm/java-21-openjdk/bin:/usr/local/bin:/usr/bin:/bin" \
  HOME="$HOME" \
  CLJ_CONFIG="$HOME/.clojure" \
  PENPOT_DATABASE_URI="$PENPOT_DATABASE_URI" \
  PENPOT_DATABASE_USERNAME="$PENPOT_DATABASE_USERNAME" \
  PENPOT_DATABASE_PASSWORD="$PENPOT_DATABASE_PASSWORD" \
  PENPOT_HTTP_SERVER_PORT="$PENPOT_HTTP_SERVER_PORT" \
  PENPOT_REDIS_URI="$PENPOT_REDIS_URI" \
  PENPOT_PUBLIC_URI="$PENPOT_PUBLIC_URI" \
  PENPOT_HOST="$PENPOT_HOST" \
  PENPOT_FLAGS="$PENPOT_FLAGS" \
  PENPOT_SECRET_KEY="$PENPOT_SECRET_KEY" \
  PENPOT_OBJECTS_STORAGE_BACKEND="$PENPOT_OBJECTS_STORAGE_BACKEND" \
  PENPOT_DELETION_DELAY="$PENPOT_DELETION_DELAY" \
  PENPOT_EXPORTER_SHARED_KEY="$PENPOT_EXPORTER_SHARED_KEY" \
  JAVA_OPTS="$JAVA_OPTS" \
  JVM_OPTS="$JVM_OPTS" \
  _HOST_CWD="$(pwd)" \
  bash -c 'cd "$_HOST_CWD" && clojure "$@"' -- -A:dev -M -m app.main "$@"
