#!/usr/bin/env bb
;; bin/generate-plugin-types
;;
;; Babashka script that reads Malli schema definitions from `common/`
;; and emits TypeScript declaration files for `@logos/plugin-types`.
;;
;; Usage:
;;   bin/generate-plugin-types [--out <dir>]
;;
;; Default output: logos-app/src/plugins/types/generated/
;;
;; Prerequisites:
;;   brew install borkdude/brew/babashka   (or see https://babashka.org)
;;
;; The script does NOT fully evaluate ClojureScript — it reads `.cljc`
;; source files as text, extracts schema definitions with regex / EDN
;; parsing, and maps them to TypeScript declarations.

(require '[clojure.string :as str]
         '[clojure.java.io :as io]
         '[babashka.fs :as fs])

;; ─────────────────────────────────────────────────────────────────────────────
;; Config
;; ─────────────────────────────────────────────────────────────────────────────

(def repo-root
  (-> (io/file *file*) .getParentFile .getParent .getAbsolutePath))

(def common-types-dir
  (str repo-root "/common/src/app/common/types"))

(def out-dir
  (or (second (drop-while #(not= "--out" %) *command-line-args*))
      (str repo-root "/logos-app/src/plugins/types/generated")))

;; ─────────────────────────────────────────────────────────────────────────────
;; Source reading helpers
;; ─────────────────────────────────────────────────────────────────────────────

(defn read-cljc
  "Slurp a .cljc file relative to common-types-dir."
  [rel-path]
  (slurp (str common-types-dir "/" rel-path)))

(defn extract-def-set
  "Extract a ClojureScript `(def name #{...})` literal as a Clojure set.
   Returns nil if not found."
  [src sym-name]
  (when-let [m (re-find (re-pattern (str "\\(def\\s+" (name sym-name) "\\s+(#\\{[^}]*\\})")) src)]
    (try (clojure.edn/read-string (second m))
         (catch Exception _ nil))))

(defn keyword->ts-string
  "Turn a ClojureScript keyword into a quoted TypeScript string literal."
  [kw]
  (str "'" (name kw) "'"))

(defn set->ts-union
  "Convert a Clojure set of keywords into a TypeScript string union."
  [s]
  (str/join " | " (map keyword->ts-string (sort s))))

;; ─────────────────────────────────────────────────────────────────────────────
;; Schema extraction — shape.cljc
;; ─────────────────────────────────────────────────────────────────────────────

(def shape-src (read-cljc "shape.cljc"))

(def shape-types
  (or (extract-def-set shape-src 'shape-types)
      #{:frame :group :bool :rect :path :text :circle :svg-raw :image}))

(def blend-modes
  (or (extract-def-set shape-src 'blend-modes)
      #{:normal :darken :multiply :color-burn :lighten :screen :color-dodge
        :overlay :soft-light :hard-light :difference :exclusion
        :hue :saturation :color :luminosity}))

(def horizontal-constraint-types
  (or (extract-def-set shape-src 'horizontal-constraint-types)
      #{:left :right :leftright :center :scale}))

(def vertical-constraint-types
  (or (extract-def-set shape-src 'vertical-constraint-types)
      #{:top :bottom :topbottom :center :scale}))

(def bool-types
  (or (extract-def-set shape-src 'bool-types)
      #{:union :difference :exclude :intersection}))

(def stroke-caps-line
  (or (extract-def-set shape-src 'stroke-caps-line)
      #{:round :square}))

(def stroke-caps-marker
  (or (extract-def-set shape-src 'stroke-caps-marker)
      #{:line-arrow :triangle-arrow :square-marker :circle-marker :diamond-marker}))

(def stroke-caps
  (into stroke-caps-line stroke-caps-marker))

(def grow-types
  (or (extract-def-set shape-src 'grow-types)
      #{:auto-width :auto-height :fixed}))

;; ─────────────────────────────────────────────────────────────────────────────
;; TypeScript emitters
;; ─────────────────────────────────────────────────────────────────────────────

(defn ts-union-type
  "Emit: export type Name = 'a' | 'b' | ...;"
  [name values]
  (str "export type " name " =\n  | " (str/join "\n  | " (map keyword->ts-string (sort values))) ";"))

(defn ts-header []
  (str/join "\n"
   ["/**"
    " * @logos/plugin-types — auto-generated from Malli schemas"
    " *"
    " * @generated by bin/generate-plugin-types"
    " * Source: common/src/app/common/types/"
    " *"
    " * DO NOT EDIT THIS FILE DIRECTLY."
    " * Re-run `bin/generate-plugin-types` to regenerate."
    " */"
    ""]))

;; ─────────────────────────────────────────────────────────────────────────────
;; Full declaration file contents
;; ─────────────────────────────────────────────────────────────────────────────

(defn generate-dts []
  (str/join "\n\n"
   [(ts-header)

    "// ─── Shape types ──────────────────────────────────────────────────────────────"
    (ts-union-type "ShapeType" shape-types)

    (ts-union-type "BlendMode" blend-modes)

    (ts-union-type "HorizontalConstraint" horizontal-constraint-types)

    (ts-union-type "VerticalConstraint" vertical-constraint-types)

    (ts-union-type "BoolType" bool-types)

    (ts-union-type "StrokeCap" stroke-caps)

    (ts-union-type "GrowType" grow-types)

    "// ─── Fill types ──────────────────────────────────────────────────────────────"
    (str/join "\n"
     ["/** CSS #rrggbb or #rrggbbaa color string */"
      "export type HexColor = string;"
      ""
      "export interface GradientStop {"
      "  /** 0–1 */"
      "  position: number;"
      "  opacity: number;"
      "  /** CSS hex color */"
      "  color: HexColor;"
      "}"
      ""
      "export interface LinearGradient {"
      "  type: 'linear';"
      "  startX: number;"
      "  startY: number;"
      "  endX: number;"
      "  endY: number;"
      "  width: number;"
      "  stops: GradientStop[];"
      "}"
      ""
      "export interface RadialGradient {"
      "  type: 'radial';"
      "  startX: number;"
      "  startY: number;"
      "  endX: number;"
      "  endY: number;"
      "  width: number;"
      "  stops: GradientStop[];"
      "}"
      ""
      "export type Gradient = LinearGradient | RadialGradient;"
      ""
      "export interface SolidFill {"
      "  type: 'solid';"
      "  /** CSS hex color */"
      "  color: HexColor;"
      "  opacity: number;"
      "}"
      ""
      "export interface GradientFill {"
      "  type: 'gradient';"
      "  gradient: Gradient;"
      "  opacity: number;"
      "}"
      ""
      "export interface ImageFill {"
      "  type: 'image';"
      "  /** Asset UUID */"
      "  imageId: string;"
      "  opacity: number;"
      "}"
      ""
      "export type Fill = SolidFill | GradientFill | ImageFill;"])

    "// ─── Stroke ───────────────────────────────────────────────────────────────────"
    (str/join "\n"
     ["export type StrokeType = 'solid' | 'dotted' | 'dashed' | 'mixed';"
      "export type StrokePosition = 'center' | 'inner' | 'outer';"
      ""
      "export interface Stroke {"
      "  color?: HexColor;"
      "  opacity?: number;"
      "  width?: number;"
      "  type?: StrokeType;"
      "  position?: StrokePosition;"
      "  capStart?: StrokeCap;"
      "  capEnd?: StrokeCap;"
      "}"])

    "// ─── Geometry ─────────────────────────────────────────────────────────────────"
    (str/join "\n"
     ["export interface Point {"
      "  x: number;"
      "  y: number;"
      "}"
      ""
      "/** Axis-aligned bounding box */"
      "export interface Rect {"
      "  x: number;"
      "  y: number;"
      "  width: number;"
      "  height: number;"
      "}"
      ""
      "/** 6-element CSS affine matrix [a, b, c, d, e, f] */"
      "export type Transform = [number, number, number, number, number, number];"])

    "// ─── Shadow / blur ────────────────────────────────────────────────────────────"
    (str/join "\n"
     ["export type ShadowType = 'drop-shadow' | 'inner-shadow';"
      ""
      "export interface Shadow {"
      "  type: ShadowType;"
      "  x: number;"
      "  y: number;"
      "  blur: number;"
      "  spread: number;"
      "  color: HexColor;"
      "  opacity: number;"
      "  hidden: boolean;"
      "}"
      ""
      "export interface Blur {"
      "  type: 'layer-blur';"
      "  value: number;"
      "  hidden: boolean;"
      "}"])

    "// ─── Core shape interface ─────────────────────────────────────────────────────"
    (str/join "\n"
     ["/**"
      " * Base shape interface — all shape variants share these fields."
      " * This is the stable API surface exposed to plugins."
      " */"
      "export interface Shape {"
      "  /** UUID v4 string */"
      "  readonly id: string;"
      "  type: ShapeType;"
      "  name: string;"
      "  x: number;"
      "  y: number;"
      "  width: number;"
      "  height: number;"
      "  /** Rotation in degrees (0–360) */"
      "  rotation: number;"
      "  /** 0 (transparent) to 1 (opaque) */"
      "  opacity: number;"
      "  hidden: boolean;"
      "  locked: boolean;"
      "  blendMode: BlendMode;"
      "  fills: Fill[];"
      "  strokes: Stroke[];"
      "  shadows: Shadow[];"
      "  blur?: Blur;"
      "  constraintsH: HorizontalConstraint;"
      "  constraintsV: VerticalConstraint;"
      "  transform: Transform;"
      "  /** UUIDs of children (frames, groups only) */"
      "  children: string[];"
      "  /** UUID of containing frame, or null for root shapes */"
      "  frameId: string | null;"
      "  /** UUID of parent shape, or null for root shapes */"
      "  parentId: string | null;"
      "  /** Corner radii [r1, r2, r3, r4] (rects only) */"
      "  corners?: [number, number, number, number];"
      "}"
      ""
      "/** Shape creation parameters */"
      "export interface CreateShapeParams {"
      "  type: ShapeType;"
      "  name?: string;"
      "  x?: number;"
      "  y?: number;"
      "  width?: number;"
      "  height?: number;"
      "  fills?: Fill[];"
      "}"
      ""
      "/** Partial shape update */"
      "export type ShapePatch = Partial<Omit<Shape, 'id' | 'type' | 'children' | 'frameId' | 'parentId'>>;"])

    "// ─── Page ─────────────────────────────────────────────────────────────────────"
    (str/join "\n"
     ["export interface Page {"
      "  readonly id: string;"
      "  name: string;"
      "  /** All shapes on this page, including off-canvas shapes. */"
      "  shapes: Shape[];"
      "}"])

    "// ─── Plugin permissions ───────────────────────────────────────────────────────"
    (str/join "\n"
     ["/**"
      " * Coarse-grained permission tokens granted at plugin load time."
      " * The host enforces these on every API call."
      " *"
      " * | Token              | Unlocks                                          |"
      " * |--------------------|--------------------------------------------------|"
      " * | `read`             | getPage, getSelection, getShape                  |"
      " * | `content`          | createRect, createEllipse, updateShape, delete   |"
      " * | `allow:network`    | fetch() from inside the sandbox (future)         |"
      " * | `allow:clipboard`  | navigator.clipboard (future)                     |"
      " */"
      "export type PluginPermission ="
      "  | 'read'"
      "  | 'content'"
      "  | 'allow:network'"
      "  | 'allow:clipboard';"
      ""
      "/** Plugin registry entry (persisted in app state) */"
      "export interface PluginRegistryEntry {"
      "  pluginId: string;"
      "  name: string;"
      "  description?: string;"
      "  host: string;"
      "  code: string;"
      "  icon?: string;"
      "  permissions: Set<string>;"
      "}"])

    "// ─── Plugin wire protocol ────────────────────────────────────────────────────"
    (str/join "\n"
     ["/** Host → Plugin: invoke a method in the plugin sandbox */"
      "export interface PluginRequest {"
      "  type: 'REQUEST';"
      "  /** Unique request ID for response correlation */"
      "  id: string;"
      "  method: string;"
      "  params: unknown;"
      "}"
      ""
      "/** Plugin → Host: response to a PluginRequest */"
      "export interface PluginResponse {"
      "  type: 'RESPONSE';"
      "  id: string;"
      "  success: boolean;"
      "  data?: unknown;"
      "  error?: string;"
      "}"
      ""
      "/** Host → Plugin: push event */"
      "export interface PluginEvent {"
      "  type: 'EVENT';"
      "  event: 'selectionChange' | 'pageChange' | 'documentChange';"
      "  payload: unknown;"
      "}"
      ""
      "export type HostMessage = PluginRequest | PluginEvent;"
      "export type PluginMessage = PluginResponse;"
      ""
      "/** Opaque handle returned by connectPlugin() */"
      "export interface PluginHandle {"
      "  readonly id: string;"
      "  readonly url: string;"
      "  readonly permissions: ReadonlySet<PluginPermission>;"
      "  disconnect(): void;"
      "}"
      ""
      "// ─── logos global (injected into plugin sandboxes)  ─────────────────────────"
      ""
      "/**"
      " * The `logos` global is injected by the bridge bootstrap into every"
      " * plugin iframe before the plugin script runs."
      " *"
      " * @example"
      " * declare const logos: LogosPluginGlobal;"
      " * const shapes = await logos.call('getSelection');"
      " */"
      "export interface LogosPluginGlobal {"
      "  /**"
      "   * Call a host API method and receive the result as a Promise."
      "   * Permission errors reject the promise."
      "   */"
      "  call<T = unknown>(method: string, params?: unknown): Promise<T>;"
      ""
      "  /**"
      "   * Register a handler for a host-push event."
      "   *"
      "   * @param event - Event name"
      "   * @param fn    - Handler function"
      "   */"
      "  on(event: 'selectionChange' | 'pageChange' | 'documentChange', fn: (payload: unknown) => void): void;"
      "}"])

    "// ─── Plugin API method signatures ────────────────────────────────────────────"
    (str/join "\n"
     ["/**"
      " * Full type-safe call signatures for all plugin API methods."
      " * Use with `logos.call<ReturnType>(method, params)`."
      " */"
      "export interface PluginApiMethods {"
      "  getPage(params?: never): Page;"
      "  getSelection(params?: never): Shape[];"
      "  getShape(params: { id: string }): Shape | null;"
      "  updateShape(params: { id: string; patch: ShapePatch }): void;"
      "  createRect(params: { x: number; y: number; width: number; height: number; name?: string }): string;"
      "  createEllipse(params: { x: number; y: number; width: number; height: number; name?: string }): string;"
      "  deleteShape(params: { id: string }): void;"
      "}"
      ""
      "/** Helper: typed logos.call() wrapper for use in plugins with full inference */"
      "export type TypedCall = <K extends keyof PluginApiMethods>("
      "  method: K,"
      "  params?: Parameters<PluginApiMethods[K]>[0]"
      ") => Promise<ReturnType<PluginApiMethods[K]>>;"])

    (str "// Generated " (java.time.Instant/now) "\n")]))

;; ─────────────────────────────────────────────────────────────────────────────
;; Write output
;; ─────────────────────────────────────────────────────────────────────────────

(fs/create-dirs out-dir)

(let [out-file (str out-dir "/index.d.ts")]
  (spit out-file (generate-dts))
  (println (str "✓ Generated " out-file)))

;; Also emit package.json if it doesn't already exist
(let [pkg-file (str (fs/parent out-dir) "/package.json")]
  (when-not (fs/exists? pkg-file)
    (spit pkg-file
      (str "{\n"
           "  \"name\": \"@logos/plugin-types\",\n"
           "  \"version\": \"0.1.0\",\n"
           "  \"description\": \"TypeScript type declarations for the Logos plugin API\",\n"
           "  \"types\": \"./generated/index.d.ts\",\n"
           "  \"license\": \"MPL-2.0\",\n"
           "  \"keywords\": [\"logos\", \"plugin\", \"types\", \"design-tool\"],\n"
           "  \"peerDependencies\": {},\n"
           "  \"files\": [\"generated/\"]\n"
           "}\n"))
    (println (str "✓ Generated " pkg-file))))

(println "Done. Run `npx tsc --noEmit` in logos-app/ to verify.")
