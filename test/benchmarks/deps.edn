{;; Standalone deps for the P1.7 benchmark tooling.
 ;; Minimal — only clojure core + data.json needed for the generator.
 :paths ["."]

 :deps {org.clojure/clojure   {:mvn/version "1.11.4"}
        org.clojure/data.json {:mvn/version "2.5.0"}}

 :aliases
 {:gen-benchmark
  {:main-opts ["-m" "benchmarks.generate-file"]}}}
